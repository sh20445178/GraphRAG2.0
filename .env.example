# ─────────────────────────────────────────────
# LLM Provider (choose one)
# ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...
# GROQ_API_KEY=...

# Model names
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ─────────────────────────────────────────────
# Optional: Reranking
# ─────────────────────────────────────────────
COHERE_API_KEY=...

# ─────────────────────────────────────────────
# Vector Store
# ─────────────────────────────────────────────
VECTOR_STORE_PATH=./data/vector_store
CHROMA_COLLECTION_NAME=graphrag_ml

# ─────────────────────────────────────────────
# Knowledge Graph
# ─────────────────────────────────────────────
GRAPH_STORE_PATH=./data/knowledge_graph.json

# ─────────────────────────────────────────────
# RAG Settings
# ─────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RETRIEVAL=10
TOP_K_RERANK=5
SIMILARITY_THRESHOLD=0.5

# ─────────────────────────────────────────────
# LangSmith (optional tracing)
# ─────────────────────────────────────────────
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=GraphRAG2.0-ML
